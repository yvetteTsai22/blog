      "variant": "return"
    },
    {
      "id": "call2",
      "from": "model",
      "to": "shell",
      "y": 295,
      "label": "think 20–60s, then read a function"
    },
    {
      "id": "res2",
      "from": "shell",
      "to": "model",
      "y": 325,
      "label": "result in ~1s",
      "variant": "return"
    },
    {
      "id": "call3",
      "from": "model",
      "to": "shell",
      "y": 400,
      "label": "think again, next lookup"
    },
    {
      "id": "res3",
      "from": "shell",
      "to": "model",
      "y": 430,
      "label": "result",
      "variant": "return"
    },
    {
      "id": "done",
