      "label": "Shell tool",
      "sublabel": "grep / sed"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 250,
      "label": "Turn 1"
    },
    {
      "from": 260,
      "to": 360,
      "label": "Turn 2"
    },
    {
      "from": 370,
      "to": 480,
      "label": "… 18 turns"
    }
  ],
  "messages": [
    {
      "id": "start",
      "from": "orch",
      "to": "model",
      "y": 165,
      "label": "review this diff",
      "variant": "emphasis"
    },
    {
      "id": "call1",
      "from": "model",
      "to": "shell",
      "y": 205,
      "label": "think 20–60s, then grep callers"
    },
    {
      "id": "res1",
      "from": "shell",
      "to": "model",
      "y": 235,
